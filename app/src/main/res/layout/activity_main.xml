<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scalc_background"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Hola, Salvador"
            android:text="Hola, Usuario"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu resumen financiero"
            android:textSize="14sp"
            android:textColor="#80000000"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/scalc_primary"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvMesActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="ENERO 2026"
                android:textColor="#E6FFFFFF"
                android:letterSpacing="0.1"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/lblSalario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ganancias totales"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMesActual"/>

            <TextView
                android:id="@+id/tvSalarioMes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="1.250,50 €"
                android:text="0.00 €"
                android:textColor="@color/white"
                android:textSize="48sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblSalario"/>

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvSalarioMes"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/divider">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            app:tint="#CCFFFFFF"/>
                        <TextView
                            android:id="@+id/tvPedidos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" Pedidos"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTotalPedidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_recent_history"
                            app:tint="#CCFFFFFF"/>
                        <TextView
                            android:id="@+id/tvHoras"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" Horas"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTotalHoras"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0h"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevaJornada"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="@string/a_adir_jornada"
        android:textSize="16sp"
        android:letterSpacing="0.05"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="@color/scalc_primary"
        app:icon="@android:drawable/ic_input_add"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/white"
        android:layout_marginTop="40dp"
        app:cornerRadius="20dp"
        app:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardResumen"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistorial"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:text="@string/historial"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_primary"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconTint="@color/scalc_primary"
            app:iconGravity="textStart"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/white"
            app:elevation="2dp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfiguracion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:text="@string/ajustes"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_primary"
            app:icon="@android:drawable/ic_menu_preferences"
            app:iconTint="@color/scalc_primary"
            app:iconGravity="textStart"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/white"
            app:elevation="2dp"
            app:cornerRadius="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>